:: StoryStylesheet [stylesheet]
tw-sidebar {
 display: none;
}

tw-story {
  font-size: 1.4em;
  line-height: 1.3em;
  color: white;
}

html {
  font: 100% Courier,Lucida Console,sans-serif;
}

body{
  background-color: #222;
  
}
tw-icon {
    opacity: .51;
}
.enchantment-link, tw-link, .visited  {
  color: Goldenrod;
}

.enchantment-link:hover, tw-link:hover, .visited:hover  {
  color: #EEE520;
}





tw-story.normal{
  color: white;
}
body.normal {
  background-color: #222;
}
tw-story.death{
  color: white;
  
}
body.death {
  background-color: black;
}
tw-story.mcdon{
  color: white;
  
}
body.mcdon {
  background-color: #400000;
}





mark {
    background-color: transparent;
}

.dimLink{
color: grey;	
}


.fadeinoutslow {
	opacity:0;
    animation: fadeinout 20s;
    -moz-animation: fadeinout 20s; /* Firefox */
    -webkit-animation: fadeinout 20s; /* Safari and Chrome */
    -o-animation: fadeinout 20s; /* Opera */
}
@keyframes fadeinoutslow { 0% { opacity:0; }  30% { opacity:1; } 100% { opacity:0; }}
@-moz-keyframes fadeinoutslow { /* Firefox */  0% { opacity:0; } 30% { opacity:1; } 100% {  opacity:0; } }
@-webkit-keyframes fadeinoutslow { /* Safari and Chrome */ 0% { opacity:0; } 30% { opacity:1; } 100% { opacity:0; } }
@-o-keyframes fadeinoutslow { /* Opera */ 0% { opacity:0; } 30% { opacity:1; } 100% { opacity:0;  }}



.fadein {
	opacity:0;
    animation: fadein 60s;
    -moz-animation: fadein 60s; /* Firefox */
    -webkit-animation: fadein 60s; /* Safari and Chrome */
    -o-animation: fadein 60s; /* Opera */
}
@keyframes fadein { 0% { opacity:0; }  10% { opacity:1; } 100% { opacity:1; }}
@-moz-keyframes fadein { /* Firefox */  0% { opacity:0; } 10% { opacity:1; } 100% {  opacity:1; } }
@-webkit-keyframes fadein { /* Safari and Chrome */ 0% { opacity:0; } 10% { opacity:1; } 100% { opacity:1; } }
@-o-keyframes fadein { /* Opera */ 0% { opacity:0; } 10% { opacity:1; } 100% { opacity:1;  }}

.fadeinfast {
	opacity:0;
    animation: fadein 60s;
    -moz-animation: fadein 60s; /* Firefox */
    -webkit-animation: fadein 60s; /* Safari and Chrome */
    -o-animation: fadein 60s; /* Opera */
}
@keyframes fadein { 0% { opacity:0; }  5% { opacity:1; } 100% { opacity:1; }}
@-moz-keyframes fadein { /* Firefox */  0% { opacity:0; } 5% { opacity:1; } 100% {  opacity:1; } }
@-webkit-keyframes fadein { /* Safari and Chrome */ 0% { opacity:0; } 5% { opacity:1; } 100% { opacity:1; } }
@-o-keyframes fadein { /* Opera */ 0% { opacity:0; } 5% { opacity:1; } 100% { opacity:1;  }}






























