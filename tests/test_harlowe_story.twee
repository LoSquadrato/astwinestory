(if: $inv_paper_count > 0)[ |towels>[The paper towels.] (click: ?towels)[(set: $sequence to 1)(go-to: "Stop up the toilet.")] ](else:)[  |towels>[<span class="dimLink">The paper towels.</span>]    |towelsFail>[](click: ?towels)[(replace: ?towelsFail)[//I don't have that.//] ] ]

