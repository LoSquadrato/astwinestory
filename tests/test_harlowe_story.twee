var audio = document.createElement('audio');
window.helpSound = function() {
	audio.src = 'https://dl.dropboxusercontent.com/u/6474152/VampGame/22%20Eerie%20Whispers%201%20Help%202.m4a';
	audio.loop = false;
	audio.play();	
}


