](elseif: $scripture_pick is "Corinthians" and $word1 is "cymbal" and $word2 is "mountains" and $word3 is "flames" and $word4 is "angered" and $word5 is "truth" and $word6 is "perfection" and $word7 is "child" and $word8 is "mirror" and $word9 is "love")[

(go-to: "Scripture Win")

](else:)[(go-to: "Scripture Lose")]
(set: $Tick to true)


