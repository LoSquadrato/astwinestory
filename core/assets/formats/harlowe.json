{
  "name": "Harlowe",
  "version": "3",
  "syntaxtype": "linear",

  "variables": {
    "global_prefix": "$",
    "local_prefix": "_"
  },

  "macros": {
    "open": "(",
    "close": ")",
    "close_tag": "",
    "hook_open": "[",
    "hook_close": "]",
    "inner": {
      "control":    ["if:", "unless:", "elseif:", "else:", "for:"],
      "output":     ["print:", "display:", "show:"],
      "assignment": ["set:", "put:", "move:", "unpack:"],
      "media":      ["icon-rotate:", "icon-counter:"],
      "meta":       ["story:", "startup:", "header:", "footer:", "debug-startup:"],
      "containers": ["a:", "dm:", "ds:"]
    }
  },

  "links": {
    "open": "[[",
    "close": "]]",
    "separators": ["|"]
  },

  "operators": {
    "assignment": ["to", "into"],
    "arithmetic": ["+", "-", "*", "/"],
    "comparison": ["is", "is not", "contains", "does not contain", "matches", ">", ">=", "<", "<="],
    "logical":    ["and", "or", "not"]
  },

  "literals": {
    "string_delimiters": ["\"", "'"],
    "boolean": ["true", "false"],
    "null": ["null"]
  },

  "formatting": {
    "bold":          ["*", "*"],
    "italic":        ["//", "//"],
    "strikethrough": ["~~", "~~"],
    "superscript":   ["^^", "^^"]
  },

  "meta": {
    "image": ["[img[", "]]"],
    "metadata": ["{", "}"],
    "tag" : ["[", "]"],
    "html" : ["<", ">"],
    "script" : ["<script>", "</script>"]
  },

  "special_passages": [
    "StoryData", "StoryTitle", "StoryBanner", "StoryInit",
    "Start", "PassageHeader", "PassageFooter", "UserStylesheet", "UserScript",
    "Modal code"
  ]
}