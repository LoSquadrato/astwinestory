{
  "name": "SugarCube",
  "version": "2",
  "syntaxtype": "markup",

  "variables": {
    "global_prefix": "$",
    "local_prefix": "_"
  },

  "macros": {
    "open": "<<",
    "close": ">>",
    "close_tag": "/",
    "hooked": {
      "control":  ["if", "for"],
      "output":   ["link", "linkreplace", "widget", "replace", "type"],
      "script":   ["script", "div"],
      "silently": ["silently"],
      "timed":    ["timed","repeat"]
    },
    "plain": {
      "control":    ["elseif", "else", "for", "switch", "case", "default"],
      "navigation": ["back", "goto"],
      "output":     ["print", "=", "include", "nobr"],
      "assignment": ["set", "unset", "run"],
      "media":      ["audio", "video", "image"],
      "meta":       ["style", "widget", "passage", "toggleclass"]
    }
  },

  "links": {
    "open": "[[",
    "close": "]]",
    "separators": ["|"]
  },

  "operators": {
    "assignment": ["to", "="],
    "arithmetic": ["+", "-", "*", "/", "%"],
    "comparison": ["eq", "neq", "gt", "gte", "lt", "lte", "===", "!==", ">", ">=", "<", "<="],
    "logical":    ["and", "or", "not", "&&", "||", "!"],
    "null":       ["null", "undefined"],
    "boolean":    ["true", "false"],
    "string":     ["+"]
  },

  "literals": {
    "string_delimiters": ["\"", "'", "`"]
  },

  "formatting": {
    "bold":          ["''", "''"],
    "italic":        ["//", "//"],
    "strike":        ["==", "=="],
    "mono":          ["@@", "@@"],
    "sub":           ["~", "~"],
    "sup":           ["^^", "^^"]
  },

  "meta": {
    "tag":        ["[", "]"],
    "images":     ["<img", ">"],
    "metadata":   ["{", "}"],
    "comment":    ["<!--", "-->"], 
    "comment2":   ["/*!", "*/"]
  },

  "html": {
    "open": "<",
    "close": ">",
    "close_tag": "/",
    "html_tags": ["div", "span", "p", "script", "style"] 
  },


  "special_passages": [
    "StoryData", "StoryTitle", "StoryBanner", "StorySubtitle", "StoryAutor", "StoryCaption", "StoryInit", "Start",
    "StoryMenu", "StoryShare", "PassageHeader", "PassageFooter",
    "PassageDone", "PassageReady", "StoryCaption", "StoryInterface"
  ]
}